/target
*.omap.bak
.DS_Store
.worktrees/
# Local state of assistants and editors: AiderDesk's tasks, JetBrains project files and the
# shell history of aider. None of it belongs to the project.
/.aider-desk/
/.idea/
/.aider.input.history
# Examples: the maps, PDF and OCAD files are kept; the fetched data and the large raster
# templates are restored by `freemapper run --ocad --pdf examples/<name>`.
/examples/*/data/
/examples/*/templates/*.jpg
/examples/*/templates/*.png
/examples/*/templates/*.jgw
/examples/*/templates/*.pgw
/examples/*/ocad/*.jpg
/examples/*/ocad/*.png
/examples/*/ocad/*.jgw
/examples/*/ocad/*.pgw
# The map preview that every run writes; the hand-made `preview.webp` of an example stays.
/examples/*/*-preview.webp
