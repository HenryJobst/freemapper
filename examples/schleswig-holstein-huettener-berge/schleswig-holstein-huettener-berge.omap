Minimum length (isolated): two dashes (4 mm - footprint 60 m).</description><combined_symbol parts="2"><part private="true"><symbol type="2" code="509.0.1" name="Railway helper: inner black dashes"><line_symbol color="2" line_width="525" minimum_length="6000" join_style="1" cap_style="0" start_offset="0" end_offset="0" dashed="true" segment_length="6000" end_length="0" show_at_least_one_symbol="true" minimum_mid_symbol_count="0" minimum_mid_symbol_count_when_closed="0" dash_length="2250" break_length="1500" dashes_in_group="1" in_group_break_length="750" mid_symbols_per_spot="1" mid_symbol_distance="0"/></symbol></part><part private="true"><symbol type="2" code="509.0.2" name="Railway, Black background"><line_symbol color="4" line_width="525" minimum_length="6000" join_style="1" cap_style="0" start_offset="0" end_offset="0" segment_length="6000" end_length="0" show_at_least_one_symbol="true" minimum_mid_symbol_count="0" minimum_mid_symbol_count_when_closed="0" dash_length="2250" break_length="1500" dashes_in_group="1" in_group_break_length="750" mid_symbols_per_spot="1" mid_symbol_distance="0"><borders><border color="2" width="150" shift="0"/></borders></line_symbol></symbol></part></combined_symbol></symbol>
